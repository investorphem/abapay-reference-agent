# The wallet that pays. Fund it on Celo with about $1 of USDC, USDT or USAT (USA₮) — no CELO needed.
# Make a fresh one with:  npm run agent -- new-wallet
PRIVATE_KEY=

# The most one payment may cost, in US dollars. The agent refuses anything above it.
MAX_USD=1

# USDC, USDT or USAT (USA₮), all on Celo.
TOKEN=USDC

# Optional: lets `npm run agent -- ask "..."` take plain-English requests (Claude, tool use).
ANTHROPIC_API_KEY=

# Optional: your agent key from https://app.ai.self.xyz (Self Agent ID). Every request is then
# signed with it and AbaPay records the payment as coming from a human-backed agent.
SELF_AGENT_KEY=
